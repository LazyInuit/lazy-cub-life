{
  "name": "lazy-lion-cub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check:bubble": "esbuild scripts/bubble-blast-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/bubble-check.mjs --log-level=warning && node node_modules/.cache/bubble-check.mjs",
    "check:power": "esbuild scripts/cub-power-check.ts --bundle --platform=node --format=esm --loader:.png=empty --outfile=node_modules/.cache/power-check.mjs --log-level=warning && node node_modules/.cache/power-check.mjs"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@supabase/supabase-js": "^2.117.3",
    "phaser": "^3.90.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
